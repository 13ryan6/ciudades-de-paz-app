{
  "expo": {
    "name": "ciudades-de-paz-app",
    "slug": "ciudades-de-paz-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para que subas tu foto de perfil o de una incidencia.",
          "cameraPermission": "La app necesita acceso a tu cámara para que tomes tu foto de perfil o de una incidencia."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app necesita tu ubicación para georreferenciar tus reportes de incidencias y respuestas de encuestas."
        }
      ]
    ]
  }
}
